# ---- Filesystem scan roots ----
# Base directory containing Codex skills, plugins, and config.
# Expected subdirectories: skills/, plugins/, config.toml
# Default: ~/.codex
CODEX_A2A_BASE_DIR=~/.codex

# Optional project directory for repo-scoped skills.
# Scans .codex/skills/ and .agents/skills/ within this directory.
# CODEX_A2A_PROJECT_DIR=/path/to/project

# Include system/bundled skills from skills/.system/
CODEX_SCAN_SYSTEM=false

# Include admin skills from /etc/codex/skills/
CODEX_SCAN_ADMIN=false

# Scan for installed plugins
CODEX_SCAN_PLUGINS=true

# ---- A2A server ----
A2A_HOST=127.0.0.1
A2A_PORT=8200
# A2A_PUBLIC_URL=http://localhost:8200

# ---- Agent card (required fields) ----
A2A_TITLE=Codex
A2A_DESCRIPTION=AI-powered coding agent by OpenAI
A2A_VERSION=1.0.1

# ---- Agent card (optional fields) ----
A2A_DOCUMENTATION_URL=https://codex.openai.com/docs
A2A_PROVIDER_ORG=OpenAI
A2A_PROVIDER_URL=https://openai.com
# A2A_ICON_URL=

# ---- Input/output modes (comma-separated MIME types) ----
A2A_INPUT_MODES=text/plain
A2A_OUTPUT_MODES=text/plain,application/json

# ---- Caching ----
CACHE_TTL_SECONDS=30
